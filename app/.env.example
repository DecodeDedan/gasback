# Which Arc network the app talks to: testnet | mainnet (default testnet)
VITE_NETWORK=testnet
# Gasback mainnet address and its creation block, printed by /deploy after you deploy from your wallet
VITE_GASBACK_MAINNET=
VITE_GASBACK_MAINNET_BLOCK=
# Optional: merchant address for the landing page "Try a $0.10 checkout" button
VITE_DEMO_MERCHANT=
